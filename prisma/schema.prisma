generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tenant: cada profissional/salão é uma Account isolada
model Account {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  services      Service[]
  availability  Availability[]
  appointments  Appointment[]
  notifications Notification[]
  expenses      Expense[]
  products      Product[]
  stockMovements StockMovement[]
}

enum UserRole {
  OWNER
  STAFF
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          UserRole @default(OWNER)
  active        Boolean  @default(true)
  bookable      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  availability      Availability[]
  staffAppointments Appointment[] @relation("AppointmentStaff")

  @@index([accountId])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([accountId])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  durationMin Int
  priceCents  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([accountId])
}

// Regras recorrentes de disponibilidade por dia da semana (0=domingo ... 6=sábado),
// por profissional (User) reservável.
model Availability {
  id          String   @id @default(cuid())
  weekday     Int
  startMinute Int // minutos desde 00:00
  endMinute   Int

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([userId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

model Appointment {
  id          String            @id @default(cuid())
  startAt     DateTime
  endAt       DateTime
  status      AppointmentStatus @default(PENDING)
  priceCents  Int
  depositPaid Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  staffId String?
  staff   User?   @relation("AppointmentStaff", fields: [staffId], references: [id], onDelete: SetNull)

  payment Payment?

  @@index([accountId, startAt])
  @@index([staffId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id                    String        @id @default(cuid())
  amountCents           Int
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  SENT
  FAILED
}

model Notification {
  id        String              @id @default(cuid())
  channel   NotificationChannel
  status    NotificationStatus
  message   String
  createdAt DateTime            @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

enum ExpenseCategory {
  ALUGUEL
  PRODUTOS
  SALARIOS
  MARKETING
  OUTROS
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amountCents Int
  category    ExpenseCategory @default(OUTROS)
  paidAt      DateTime
  createdAt   DateTime        @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, paidAt])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String?
  unit          String   @default("un")
  costCents     Int      @default(0)
  priceCents    Int      @default(0)
  stockQty      Int      @default(0)
  lowStockAlert Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  movements StockMovement[]

  @@index([accountId])
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model StockMovement {
  id        String            @id @default(cuid())
  type      StockMovementType
  quantity  Int
  reason    String?
  createdAt DateTime          @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, productId])
}
